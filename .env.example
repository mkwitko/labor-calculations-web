# Backend API URL
VITE_HTTP_API_URL=http://localhost:3000

# Storage URL (Cloudflare R2 or similar)
VITE_STORAGE_URL=

# Business defaults
VITE_DEFAULT_FGTS_RATE=8
VITE_DEFAULT_MINIMUM_WAGE=1325

# PostHog product analytics (public project key — safe in client bundle)
VITE_POSTHOG_KEY=
# Deixe VAZIO em produção: o padrão é o proxy reverso de primeira parte `/lxl`
# (worker/index.ts), que é o que sobrevive a bloqueador de anúncio. Preencher
# com https://us.i.posthog.com desliga o proxy — só para depurar.
VITE_POSTHOG_HOST=

# Sentry (optional)
VITE_SENTRY_DSN=
